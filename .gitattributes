# Preserve the exact bytes recorded in the media corpus SHA-256 manifest.
tests/fixtures/media/**/*.m3u8 text eol=lf
tests/fixtures/media/**/*.ts -text
tests/fixtures/media/**/*.m4s -text
tests/fixtures/media/**/*.fmp4 -text

# Independent AES-128 ciphertext must never undergo newline conversion.
tests/fixtures/crypto/**/*.cbc -text
tests/fixtures/crypto/**/*.bin -text
tests/fixtures/crypto/*.cbc -text
tests/fixtures/crypto/**/*.m3u8 text eol=lf
tests/runtime/playlist.m3u8 text eol=lf

# Independent sample-encrypted media.
tests/fixtures/sample_crypto/**/*.mp4 -text
tests/fixtures/sample_crypto/**/*.m4s -text
tests/fixtures/sample_crypto/**/*.ts -text
tests/fixtures/sample_crypto/**/*.m3u8 text eol=lf
